# ==============================================================================
# mcp-physics-bridge: Production Environment Configuration Template
# ==============================================================================

# Runtime Environment (development | production | test)
NODE_ENV=production

# ------------------------------------------------------------------------------
# Network Ports & Protocol Addresses
# ------------------------------------------------------------------------------
# Native Game Engine gRPC bi-directional streaming port (Unity, Unreal, Godot)
MCP_GRPC_PORT=50051

# Web Engine gRPC-Web proxy and JSON REST gateway port (Phaser, Browser)
MCP_GRPC_WEB_PORT=50052

# Continuous 60 FPS physics WebSocket port
MCP_WS_PORT=8080

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# WebSocket authentication token for CSWSH protection.
# If omitted or left empty, the server automatically generates a 256-bit secure
# ephemeral token at boot and writes it to data/.runtime_token.
MCP_PHYSICS_WS_TOKEN=

# Comma-separated list of allowed browser origins for CORS and WebSocket CSWSH defense.
# Set to * in development, or your production frontend domain (e.g. https://mygame.com)
MCP_CORS_ALLOWED_ORIGINS=https://mygame.com,http://localhost:3000

# Max WebSocket frame payload size in bytes (Default: 5242880 = 5 MB)
MCP_MAX_WS_PAYLOAD_BYTES=5242880

# Max concurrent WebSocket client connections (Default: 1000)
MCP_MAX_WS_CLIENTS=1000

# Max HTTP body payload size for gRPC-Web bridge in bytes (Default: 10485760 = 10 MB)
MCP_MAX_HTTP_BODY_BYTES=10485760

# Optional TLS / SSL certificates for native gRPC stream encryption
MCP_ENABLE_TLS=false
MCP_TLS_CERT_PATH=/etc/ssl/certs/physics_bridge.crt
MCP_TLS_KEY_PATH=/etc/ssl/private/physics_bridge.key

# ------------------------------------------------------------------------------
# Embedded SQLite-Vector Storage & Target Simulation Rate
# ------------------------------------------------------------------------------
# Embedded SQLite file storage location (use :memory: for ephemeral tests)
MCP_VECTOR_DB_PATH=./data/physics_keyframes.sqlite

# Target Physics Tick Rate in Hertz (Default: 60 FPS)
MCP_TARGET_FPS=60

# Max WebAssembly sandbox memory in 64KB pages (Default: 4 pages = 256 KB)
MCP_MAX_WASM_PAGES=4

# Sandbox execution timeout per frame in milliseconds (Default: 16 ms)
MCP_WASM_TIMEOUT_MS=16

# ------------------------------------------------------------------------------
# Bring-Your-Own-Key (BYOK) AI Reasoning Provider Settings
# ------------------------------------------------------------------------------
# AI Provider: openai | anthropic | gemini | ollama | custom | mock
# Note: Defaults to "mock" for 100% offline development without requiring an API key.
LLM_PROVIDER=mock

# LLM API Authentication Key (Optional; only needed if connecting live commercial models)
LLM_API_KEY=

# Custom API endpoint (Optional; e.g. for Ollama or local inference proxy)
# Ollama example: http://localhost:11434/v1
LLM_API_ENDPOINT=

# Model identifier
LLM_MODEL=gpt-4o

# Generation temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# Maximum generation token length
LLM_MAX_TOKENS=2048

# LLM request timeout in milliseconds
LLM_TIMEOUT_MS=15000
